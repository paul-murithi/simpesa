{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@app/db": ["./packages/db/src/index.ts"],
      "@app/queue": ["./packages/queue/src/index.ts"],
      "@app/types": ["./packages/types/src/index.ts"],
      "@app/utils": ["./packages/utils/src/index.ts"],
      "apps/api/*": ["./apps/api/src/*"],
      "apps/worker/*": ["./apps/worker/src/*"]
    }
  }
}
