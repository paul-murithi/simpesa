# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/simpesa
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/simpesa_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Configuration
JWT_SECRET=your_super_secret_jwt_key
PASSKEY_SALT_ROUNDS=10

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Configuration
PIN_TIMEOUT_MS=900000 # 15 minutes
PROCESSING_VISIBILITY_DELAY_MS=5000
